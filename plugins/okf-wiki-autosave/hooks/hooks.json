{
  "description": "Maintain opted-in shared OKF documents after agent turns.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/okf_autosave.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 120,
            "statusMessage": "Updating shared OKF documents"
          }
        ]
      }
    ]
  }
}
